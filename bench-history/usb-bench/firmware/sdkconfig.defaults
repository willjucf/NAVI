# NAVI firmware defaults.
#
# Anything set here is a project decision rather than a personal preference, so
# it is checked in and every build starts from the same place.

CONFIG_IDF_TARGET="esp32"

# Console and logging live on UART0, never on the packet UART.
# On this board the CP2102 shares IO16 and IO17 with the Pi link, so log text on
# UART2 would be injected straight into the packet stream. See docs/wiring.md.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Task watchdog, report 6.16. The 500 ms window is the number in Table 2.4.1
# and in the loss of signal specification, so both watchdog layers agree.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1
CONFIG_ESP_TASK_WDT_PANIC=y

# Keep GPIO interrupt handling in IRAM so the e stop still responds while the
# flash cache is busy. This is part of holding the 500 ms budget.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# The default is fine for us and keeps the binary smaller.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
