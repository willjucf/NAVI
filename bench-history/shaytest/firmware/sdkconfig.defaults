# NAVI firmware defaults.
#
# Project decisions, not personal preferences, so every build starts the same.

CONFIG_IDF_TARGET="esp32"

# Console and logs on UART0, never the packet UART. On the PCB the CP2102
# shares IO16 and IO17 with the Pi link, so logs on UART2 would land in the
# packet stream. See docs/wiring.md.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Task watchdog (report 6.16). main.cpp tightens it to 500 ms at runtime to
# match Table 2.4.1 and the loss of signal spec, so both layers agree.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1
CONFIG_ESP_TASK_WDT_PANIC=y

# GPIO interrupt code in IRAM so the e stop still fires while the flash cache
# is busy. Part of holding the 500 ms budget.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Smaller binary, speed is fine for us.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
